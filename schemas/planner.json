{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent API",
    "version": "1.1.0",
    "description": "Runs the full Planner → Solver → Critic pipeline and returns the combined result. Steps with independent dependencies execute in parallel."
  },
  "paths": {
    "/api/agent": {
      "post": {
        "operationId": "agentRun",
        "summary": "Run the full agent pipeline for a task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["task"],
                "properties": {
                  "task":    { "type": "string", "description": "High-level task description" },
                  "context": { "type": "object", "description": "Optional context / facts" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full pipeline result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "step":      { "type": "integer" },
                          "action":    { "type": "string" },
                          "dependsOn": { "type": "array", "items": { "type": "integer" }, "description": "Step numbers that must complete before this step." }
                        }
                      }
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "step":     { "type": "object" },
                          "result":   { "type": "object" },
                          "rounds":   { "type": "integer" },
                          "accepted": { "type": "boolean" }
                        }
                      }
                    },
                    "summary": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required field",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "error": { "type": "string" } } }
              }
            }
          },
          "500": {
            "description": "Pipeline execution error",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "error": { "type": "string" } } }
              }
            }
          }
        }
      }
    },
    "/api/agent/stream": {
      "post": {
        "operationId": "agentStream",
        "summary": "Run the agent pipeline with Server-Sent Events streaming",
        "description": "Identical to POST /api/agent but responses are streamed as text/event-stream. Each event is a `data: <JSON>\\n\\n` line. Final event has type 'done' or 'error'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["task"],
                "properties": {
                  "task":    { "type": "string" },
                  "context": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream of agent progress events",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
