{
  "openapi": "3.1.0",
  "info": {
    "title": "Solver Agent (internal)",
    "version": "1.1.0",
    "description": "Internal component: executes a single step using a ReAct loop, calling MCP tools as needed. Invoked by the kernel; not directly accessible via HTTP."
  },
  "components": {
    "schemas": {
      "SolverInput": {
        "type": "object",
        "required": ["step"],
        "properties": {
          "step": {
            "type": "object",
            "description": "Step object produced by the Planner",
            "properties": {
              "step":      { "type": "integer" },
              "action":    { "type": "string" },
              "dependsOn": { "type": "array", "items": { "type": "integer" } }
            }
          },
          "context": {
            "type": "object",
            "description": "Enriched execution context including scratchpad from prior steps"
          }
        }
      },
      "SolverOutput": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "description": "Result of executing the step"
          },
          "toolsUsed": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Names of all MCP tools invoked during the ReAct loop"
          }
        }
      },
      "ToolCallEvent": {
        "type": "object",
        "description": "Streaming event emitted when the solver invokes a tool",
        "properties": {
          "type": { "type": "string", "enum": ["tool_call"] },
          "tool": { "type": "string" },
          "args": { "type": "object" }
        }
      },
      "ToolResultEvent": {
        "type": "object",
        "description": "Streaming event emitted after a tool returns its result",
        "properties": {
          "type":   { "type": "string", "enum": ["tool_result"] },
          "tool":   { "type": "string" },
          "result": {}
        }
      }
    }
  }
}
