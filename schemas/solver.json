{
  "openapi": "3.1.0",
  "info": {
    "title": "Solver Agent",
    "version": "1.0.0",
    "description": "Executes a single step, optionally invoking MCP tools."
  },
  "paths": {
    "/api/agent": {
      "post": {
        "operationId": "solverRun",
        "summary": "Execute a step",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["step"],
                "properties": {
                  "step": {
                    "type": "object",
                    "properties": {
                      "step": { "type": "integer" },
                      "action": { "type": "string" }
                    }
                  },
                  "context": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Solver result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": { "type": "string" },
                    "toolsUsed": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
