# ─── QuantumForge Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control — it is in .gitignore.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: openai | anthropic | openrouter | ollama | offline
# If blank, the server starts in offline-stub mode.
QFORGE_PROVIDER=

# ── API Keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Ollama needs no key, but must be running:  ollama serve

# ── Cost Control ──────────────────────────────────────────────────────────────
# Maximum USD to spend on LLM calls per process. Set to blank for unlimited.
# Example: 5.00
COST_BUDGET_USD=

# ── Ollama (local, free) ──────────────────────────────────────────────────────
# Only needed if QFORGE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# ── Server ────────────────────────────────────────────────────────────────────
PORT=18789
HOST=127.0.0.1
